# ==============================================================================
# HealthTwin AI - Backend Environment Configuration Example
# ==============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Configuration
# Obtain these from: https://supabase.com/dashboard -> Project -> Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Backend Service Role Secret Key (NEVER expose this in frontend or client code)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# AI Provider Configuration (Optional - for real LLM summarization / copilot)
# ------------------------------------------------------------------------------
AI_PROVIDER_API_KEY=your_ai_api_key_here
AI_PROVIDER_MODEL=gpt-4o-mini
AI_PROVIDER_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Application Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_jwt_secret_for_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin(s)
CORS_ORIGIN=http://localhost:5173

# Auto-seed initial synthetic demo datasets on server startup if table is empty
ENABLE_DEMO_SEED=true
